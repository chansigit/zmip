  "cards": [
    {
      "dot": "cyan",
      "title": "四个阶段",
      "items": [
        "plan：agent 按 UMAP 岛把 coarse label 分组成谱系",
        "zoom：每个谱系独立重嵌入、打外来分数、逐簇注释",
        "merge：折回全局对象并做覆盖与一致性校验",
        "publish：staging 后按 journal 原子发布"
      ]
    },
    {
      "dot": "emerald",
      "title": "宿主守卫",
      "items": [
        "每个 coarse label 恰好归入一个谱系，跨岛合并被拒绝",
        "survivors + removed 必须恰好划分谱系输入",
        "审计 CSV 与 H5AD 的 reassign 决策逐格比对"
      ]
    },
    {
      "dot": "amber",
      "title": "可恢复 resume",
      "items": [
        "收据记录输入哈希、选项、依赖源码哈希",
        "agent 设置只记录不比较，可换 max-turns 续跑",
        "一次只允许一个父进程写输出目录"
      ]
    }
  ]
